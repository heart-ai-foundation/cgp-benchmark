@@ -26,11 +26,28 @@ test("renderItemList joins item names", async () => {
 
 test("submitLogin delegates valid credentials", async () => {
   const { submitLogin } = await importJsx("../src/components/LoginForm.jsx");
+  let authenticateCalls = 0;
   const result = submitLogin(
     { email: "ada@example.com", password: "secret" },
-    (payload) => ({ ok: true, payload })
+    (payload) => {
+      authenticateCalls += 1;
+      return { ok: true, payload };
+    }
   );
 
   assert.equal(result.ok, true);
   assert.equal(result.payload.email, "ada@example.com");
+  assert.equal(authenticateCalls, 1);
+});
+
+test("submitLogin returns an error for an empty password", async () => {
+  const { submitLogin } = await importJsx("../src/components/LoginForm.jsx");
+  const result = submitLogin(
+    { email: "ada@example.com", password: "" },
+    () => {
+      throw new Error("authenticate should not be called");
+    }
+  );
+
+  assert.deepEqual(result, { ok: false, error: "Password is required" });
 });

