 ITEMS = [
@@ -21,3 +22,44 @@ def get_item(item_id: int) -> dict | None:
         if item.id == item_id:
             return item.as_dict()
     return None
+
+
+def _get_item_model(item_id: int) -> Item | None:
+    for item in ITEMS:
+        if item.id == item_id:
+            return item
+    return None
+
+
+def _get_owned_item(user_id: int, item_id: int) -> Item:
+    user = get_user(user_id)
+    item = _get_item_model(item_id)
+    if user is None or item is None or not user.owns_item(item_id):
+        raise ValueError("item is not owned by user")
+    return item
+
+
+def favorite_item(user_id: int, item_id: int) -> dict:
+    item = _get_owned_item(user_id, item_id)
+    user = get_user(user_id)
+    user.favorite_item(item_id)
+    return item.as_dict()
+
+
+def unfavorite_item(user_id: int, item_id: int) -> dict:
+    item = _get_owned_item(user_id, item_id)
+    user = get_user(user_id)
+    user.unfavorite_item(item_id)
+    return item.as_dict()
+
+
+def list_favorite_items(user_id: int) -> list[dict]:
+    user = get_user(user_id)
+    if user is None:
+        return []
+    return [
+        item.as_dict()
+        for item_id in user.favorite_item_ids
+        for item in [_get_item_model(item_id)]
+        if item is not None
+    ]
