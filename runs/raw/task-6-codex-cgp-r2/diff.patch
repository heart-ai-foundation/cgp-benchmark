+
   const result = submitLogin(
     { email: "ada@example.com", password: "secret" },
-    (payload) => ({ ok: true, payload })
+    authenticate
   );
 
   assert.equal(result.ok, true);
+  assert.equal(calls, 1);
   assert.equal(result.payload.email, "ada@example.com");
