+from src.api.routes.items import get_item, list_items, favorite_item, unfavorite_item, list_favorite_items
+import pytest
 
 
 def test_list_items_omits_archived_items_by_default():
@@ -8,3 +9,53 @@ def test_list_items_omits_archived_items_by_default():
 
 def test_get_item_returns_matching_item():
     assert get_item(1)["name"] == "Notebook"
+
+
+def test_favorite_item_success():
+    # User 1 owns item 1
+    result = favorite_item(1, 1)
+    assert result["id"] == 1
+    favorites = list_favorite_items(1)
+    assert any(f["id"] == 1 for f in favorites)
+
+
+def test_favorite_item_non_owned_fails():
+    # User 1 does NOT own item 3 (User 2 owns it)
+    with pytest.raises(ValueError, match="User does not own item"):
+        favorite_item(1, 3)
+
+
+def test_favorite_item_idempotent():
+    favorite_item(1, 1)
+    favorite_item(1, 1)
+    favorites = list_favorite_items(1)
+    assert len([f for f in favorites if f["id"] == 1]) == 1
+
+
+def test_unfavorite_item_success():
+    favorite_item(1, 1)
+    unfavorite_item(1, 1)
+    favorites = list_favorite_items(1)
+    assert not any(f["id"] == 1 for f in favorites)
+
+
+def test_unfavorite_item_idempotent():
+    # Not favorited, should not fail
+    unfavorite_item(1, 1)
+    unfavorite_item(1, 1)
+    favorites = list_favorite_items(1)
+    assert not any(f["id"] == 1 for f in favorites)
+
+
+def test_unfavorite_non_existent_item_fails():
+    with pytest.raises(ValueError, match="Item 999 not found"):
+        unfavorite_item(1, 999)
+
+
+def test_list_favorite_items():
+    favorite_item(1, 1)
+    favorite_item(1, 2)
+    favorites = list_favorite_items(1)
+    ids = [f["id"] for f in favorites]
+    assert 1 in ids
+    assert 2 in ids
