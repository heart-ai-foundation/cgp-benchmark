diff --git a/benchmark-repo/src/api/routes/items.py b/benchmark-repo/src/api/routes/items.py
index eebe5c5..100aeca 100644
--- a/benchmark-repo/src/api/routes/items.py
+++ b/benchmark-repo/src/api/routes/items.py
@@ -1,4 +1,5 @@
 from src.models.item import Item
+from src.api.routes.users import get_user
 
 
 ITEMS = [
@@ -21,3 +22,56 @@ def get_item(item_id: int) -> dict | None:
         if item.id == item_id:
             return item.as_dict()
     return None
+
+
+def _get_item_obj(item_id: int) -> Item | None:
+    for item in ITEMS:
+        if item.id == item_id:
+            return item
+    return None
+
+
+def favorite_item(user_id: int, item_id: int) -> dict:
+    user = get_user(user_id)
+    if not user:
+        raise ValueError(f"User {user_id} not found")
+
+    item = _get_item_obj(item_id)
+    if not item:
+        raise ValueError(f"Item {item_id} not found")
+
+    if not user.owns_item(item_id):
+        raise ValueError("User does not own item")
+
+    if item_id not in user.favorite_item_ids:
+        user.favorite_item_ids.append(item_id)
+
+    return item.as_dict()
+
+
+def unfavorite_item(user_id: int, item_id: int) -> dict:
+    user = get_user(user_id)
+    if not user:
+        raise ValueError(f"User {user_id} not found")
+
+    if item_id in user.favorite_item_ids:
+        user.favorite_item_ids.remove(item_id)
+
+    item = _get_item_obj(item_id)
+    if not item:
+        raise ValueError(f"Item {item_id} not found")
+
+    return item.as_dict()
+
+
+def list_favorite_items(user_id: int) -> list[dict]:
+    user = get_user(user_id)
+    if not user:
+        raise ValueError(f"User {user_id} not found")
+
+    favorite_items = []
+    for item_id in user.favorite_item_ids:
+        item = _get_item_obj(item_id)
+        if item:
+            favorite_items.append(item.as_dict())
+    return favorite_items
