index bdb58ef..98cbe8c 100644
--- a/benchmark-repo/src/models/user.py
+++ b/benchmark-repo/src/models/user.py
@@ -3,6 +3,31 @@ from dataclasses import dataclass, field
 
 @dataclass
 class User:
+    """A user model representing a system user with authentication and item ownership capabilities.
+    
+    This class represents a user in the system with basic profile information,
+    authentication status, and item ownership tracking.
+    
+    Attributes:
+        id (int): Unique identifier for the user.
+        email (str): User's email address, used for login validation.
+        name (str): Display name of the user.
+        active (bool): Whether the user account is active. Defaults to True.
+        item_ids (list[int]): List of item IDs owned by this user. Defaults to empty list.
+    
+    Example:
+        >>> user = User(id=1, email="john@example.com", name="John Doe")
+        >>> user.can_login()
+        True
+        >>> user.owns_item(123)
+        False
+        >>> user.item_ids.append(123)
+        >>> user.owns_item(123)
+        True
+        >>> inactive_user = User(id=2, email="jane@example.com", name="Jane", active=False)
+        >>> inactive_user.can_login()
+        False
+    """
     id: int
     email: str
     name: str
