 import pytest
 
-from src.api.validators import require_non_empty, validate_positive_int
+from src.api.validators import require_non_empty, validate_positive_int, validate_email
 
 
 def test_require_non_empty_strips_value():
@@ -14,3 +14,18 @@ def test_require_non_empty_rejects_blank():
 
 def test_validate_positive_int_accepts_positive_integer():
     assert validate_positive_int(3, "count") == 3
+
+
+@pytest.mark.parametrize("email,expected", [
+    ("test@example.com", True),
+    ("user.name@domain.co.uk", True),
+    ("user+tag@example.com", True),
+    ("invalid-email", False),
+    ("test@", False),
+    ("@example.com", False),
+    ("test@example", False),
+    (None, False),
+    (123, False),
+])
+def test_validate_email(email, expected):
+    assert validate_email(email) is expected

