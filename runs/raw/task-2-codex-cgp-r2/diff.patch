--- a/benchmark-repo/src/models/user.py
+++ b/benchmark-repo/src/models/user.py
@@ -3,6 +3,29 @@ from dataclasses import dataclass, field
 
 @dataclass
 class User:
+    """Represent an application user and their item ownership.
+
+    Attributes:
+        id: Unique numeric identifier for the user.
+        email: Email address used to identify the user during login.
+        name: Display name for the user.
+        active: Whether the user account is enabled for login checks.
+        item_ids: Identifiers for items owned by the user.
+
+    Methods:
+        can_login: Return ``True`` when the account is active and the email
+            address contains an ``@`` character.
+        owns_item: Return ``True`` when the provided item identifier appears
+            in ``item_ids``.
+
+    Example:
+        >>> user = User(id=1, email="ada@example.com", name="Ada", item_ids=[1, 2])
+        >>> user.can_login()
+        True
+        >>> user.owns_item(2)
+        True
+    """
+
     id: int
     email: str
     name: str

