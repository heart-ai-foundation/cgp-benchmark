+from src.api.routes.users import get_user, list_user_items, list_users
 
 
 def test_list_users_returns_active_users():
@@ -13,3 +13,17 @@ def test_get_user_returns_matching_user():
     user = get_user(1)
     assert user is not None
     assert user.name == "Ada"
+
+
+def test_list_user_items_returns_items_owned_by_user():
+    items = list_user_items(1)
+    assert [item["name"] for item in items] == ["Notebook", "Pen"]
+
+
+def test_list_user_items_excludes_items_owned_by_other_users():
+    items = list_user_items(1)
+    assert all(item["owner_id"] == 1 for item in items)
+
+
+def test_list_user_items_returns_empty_list_for_unknown_user():
+    assert list_user_items(999) == []

