 ITEMS = [
@@ -21,3 +22,45 @@ def get_item(item_id: int) -> dict | None:
         if item.id == item_id:
             return item.as_dict()
     return None
+
+
+def favorite_item(user_id: int, item_id: int) -> dict:
+    user = get_user(user_id)
+    if not user:
+        raise ValueError("User not found")
+
+    item = get_item(item_id)
+    if not item:
+        raise ValueError("Item not found")
+
+    if not user.owns_item(item_id):
+        raise ValueError("Cannot favorite a non-owned item")
+
+    if item_id not in user.favorite_item_ids:
+        user.favorite_item_ids.append(item_id)
+
+    return {"user_id": user_id, "item_id": item_id, "status": "favorited"}
+
+
+def unfavorite_item(user_id: int, item_id: int) -> dict:
+    user = get_user(user_id)
+    if not user:
+        raise ValueError("User not found")
+
+    if item_id in user.favorite_item_ids:
+        user.favorite_item_ids.remove(item_id)
+
+    return {"user_id": user_id, "item_id": item_id, "status": "unfavorited"}
+
+
+def list_favorite_items(user_id: int) -> list[dict]:
+    user = get_user(user_id)
+    if not user:
+        raise ValueError("User not found")
+
+    favorites = []
+    for item_id in user.favorite_item_ids:
+        item = get_item(item_id)
+        if item:
+            favorites.append(item)
+    return favorites
