 def test_require_non_empty_strips_value():
@@ -14,3 +14,36 @@ def test_require_non_empty_rejects_blank():
 
 def test_validate_positive_int_accepts_positive_integer():
     assert validate_positive_int(3, "count") == 3
+
+
+@pytest.mark.parametrize(
+    "email",
+    [
+        "user@example.com",
+        "user.name+tag@example.co.uk",
+        "USER_123@example-domain.org",
+    ],
+)
+def test_validate_email_accepts_well_formed_addresses(email):
+    assert validate_email(email) is True
+
+
+@pytest.mark.parametrize(
+    "email",
+    [
+        "",
+        "plainaddress",
+        "missing-at.example.com",
+        "missing-domain@",
+        "@missing-local.example.com",
+        "user@example",
+        "user@.example.com",
+        "user@example..com",
+        "user@example-.com",
+        "user@-example.com",
+        "user name@example.com",
+        None,
+    ],
+)
+def test_validate_email_rejects_malformed_addresses(email):
+    assert validate_email(email) is False

