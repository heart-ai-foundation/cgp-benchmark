@@ -1,4 +1,5 @@
 from src.models.user import User
+from src.api.routes.items import ITEMS
 
 
 USERS = [
@@ -20,3 +21,17 @@ def get_user(user_id: int) -> User | None:
         if user.id == user_id:
             return user
     return None
+
+
+def get_user_items(user_id: int) -> list[dict]:
+    """Get all items belonging to a specific user."""
+    user = get_user(user_id)
+    if user is None:
+        return []
+    
+    user_items = []
+    for item in ITEMS:
+        if item.owner_id == user_id:
+            user_items.append(item.as_dict())
+    
+    return user_items
