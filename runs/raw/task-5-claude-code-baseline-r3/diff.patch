 from src.models.item import Item
 
 
@@ -21,3 +22,43 @@ def get_item(item_id: int) -> dict | None:
         if item.id == item_id:
             return item.as_dict()
     return None
+
+
+def _find_item(item_id: int) -> Item | None:
+    for item in ITEMS:
+        if item.id == item_id:
+            return item
+    return None
+
+
+def favorite_item(user_id: int, item_id: int) -> dict:
+    user = get_user(user_id)
+    if user is None:
+        return {"ok": False, "error": "user_not_found"}
+    if _find_item(item_id) is None:
+        return {"ok": False, "error": "item_not_found"}
+    if not user.owns_item(item_id):
+        return {"ok": False, "error": "not_owner"}
+    if item_id not in user.favorite_item_ids:
+        user.favorite_item_ids.append(item_id)
+    return {"ok": True, "user_id": user.id, "item_id": item_id, "favorited": True}
+
+
+def unfavorite_item(user_id: int, item_id: int) -> dict:
+    user = get_user(user_id)
+    if user is None:
+        return {"ok": False, "error": "user_not_found"}
+    if item_id in user.favorite_item_ids:
+        user.favorite_item_ids.remove(item_id)
+    return {"ok": True, "user_id": user.id, "item_id": item_id, "favorited": False}
+
+
+def list_favorite_items(user_id: int) -> list[dict]:
+    user = get_user(user_id)
+    if user is None:
+        return []
+    return [
+        item.as_dict()
+        for item in ITEMS
+        if item.id in user.favorite_item_ids
+    ]
