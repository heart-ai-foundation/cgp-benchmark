 def test_require_non_empty_strips_value():
@@ -14,3 +18,16 @@ def test_require_non_empty_rejects_blank():
 
 def test_validate_positive_int_accepts_positive_integer():
     assert validate_positive_int(3, "count") == 3
+
+
+def test_validate_email_success():
+    assert validate_email("user@example.com") is True
+    assert validate_email("user.name+tag@example.co.uk") is True
+
+
+def test_validate_email_failure():
+    assert validate_email("invalid-email") is False
+    assert validate_email("user@") is False
+    assert validate_email("@example.com") is False
+    assert validate_email("user@example") is False
+    assert validate_email("user@example.c") is False

