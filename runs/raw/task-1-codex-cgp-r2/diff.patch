 def test_require_non_empty_strips_value():
@@ -14,3 +14,43 @@ def test_require_non_empty_rejects_blank():
 
 def test_validate_positive_int_accepts_positive_integer():
     assert validate_positive_int(3, "count") == 3
+
+
+@pytest.mark.parametrize(
+    "email",
+    [
+        "user@example.com",
+        "first.last@example.co",
+        "user+tag@sub.example.org",
+        "a_b-c@example-domain.com",
+    ],
+)
+def test_validate_email_accepts_well_formed_email(email):
+    assert validate_email(email) is True
+
+
+@pytest.mark.parametrize(
+    "email",
+    [
+        "",
+        "plain-address",
+        "missing-domain@",
+        "@missing-local.com",
+        "two@@example.com",
+        "user@example",
+        "user@example..com",
+        "user@-example.com",
+        "user@example-.com",
+        ".user@example.com",
+        "user.@example.com",
+        "user..name@example.com",
+        "user name@example.com",
+        "user@example.com ",
+    ],
+)
+def test_validate_email_rejects_malformed_email(email):
+    assert validate_email(email) is False
+
+
+def test_validate_email_rejects_non_string_value():
+    assert validate_email(None) is False

