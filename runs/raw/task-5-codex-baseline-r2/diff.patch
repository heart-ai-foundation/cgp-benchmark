 def test_get_item_returns_matching_item():
     assert get_item(1)["name"] == "Notebook"
+
+
+def test_user_can_favorite_an_owned_item():
+    item = favorite_item(1, 1)
+
+    assert item["name"] == "Notebook"
+    assert list_favorite_items(1) == [item]
+
+
+def test_user_can_unfavorite_an_item():
+    favorite_item(1, 1)
+
+    item = unfavorite_item(1, 1)
+
+    assert item["name"] == "Notebook"
+    assert list_favorite_items(1) == []
