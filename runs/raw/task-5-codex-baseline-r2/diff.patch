+    assert list_favorite_items(1) == []
+
+
+def test_favoriting_same_item_twice_is_idempotent():
+    favorite_item(1, 1)
+    favorite_item(1, 1)
+
+    assert [item["id"] for item in list_favorite_items(1)] == [1]
