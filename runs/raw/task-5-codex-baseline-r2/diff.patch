 ITEMS = [
@@ -21,3 +22,41 @@ def get_item(item_id: int) -> dict | None:
         if item.id == item_id:
             return item.as_dict()
     return None
+
+
+def favorite_item(user_id: int, item_id: int) -> dict:
+    user = get_user(user_id)
+    if user is None:
+        raise ValueError("User not found")
+
+    item = get_item(item_id)
+    if item is None:
+        raise ValueError("Item not found")
+
+    user.favorite_item(item_id)
+    return item
+
+
+def unfavorite_item(user_id: int, item_id: int) -> dict:
+    user = get_user(user_id)
+    if user is None:
+        raise ValueError("User not found")
+
+    item = get_item(item_id)
+    if item is None:
+        raise ValueError("Item not found")
+
+    user.unfavorite_item(item_id)
+    return item
+
+
+def list_favorite_items(user_id: int) -> list[dict]:
+    user = get_user(user_id)
+    if user is None:
+        raise ValueError("User not found")
+
+    return [
+        item.as_dict()
+        for item in ITEMS
+        if item.id in user.favorite_item_ids
+    ]
diff --git a/benchmark-repo/src/models/user.py b/benchmark-repo/src/models/user.py
index bdb58ef..edce9e1 100644
--- a/benchmark-repo/src/models/user.py
+++ b/benchmark-repo/src/models/user.py
@@ -8,9 +8,20 @@ class User:
     name: str
     active: bool = True
     item_ids: list[int] = field(default_factory=list)
+    favorite_item_ids: list[int] = field(default_factory=list)
 
     def can_login(self) -> bool:
         return self.active and "@" in self.email
 
     def owns_item(self, item_id: int) -> bool:
         return item_id in self.item_ids
+
+    def favorite_item(self, item_id: int) -> None:
+        if not self.owns_item(item_id):
+            raise ValueError("Cannot favorite an item the user does not own")
+        if item_id not in self.favorite_item_ids:
+            self.favorite_item_ids.append(item_id)
+
+    def unfavorite_item(self, item_id: int) -> None:
+        if item_id in self.favorite_item_ids:
+            self.favorite_item_ids.remove(item_id)
