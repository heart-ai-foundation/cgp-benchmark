diff --git a/benchmark-repo/frontend/tests/components.test.js b/benchmark-repo/frontend/tests/components.test.js
index 149df18..45ab729 100644
--- a/benchmark-repo/frontend/tests/components.test.js
+++ b/benchmark-repo/frontend/tests/components.test.js
@@ -34,3 +34,15 @@ test("submitLogin delegates valid credentials", async () => {
   assert.equal(result.ok, true);
   assert.equal(result.payload.email, "ada@example.com");
 });
+
+test("submitLogin returns error for empty password", async () => {
+  const { submitLogin } = await importJsx("../src/components/LoginForm.jsx");
+  const result = submitLogin(
+    { email: "ada@example.com", password: "" },
+    () => {
+      throw new Error("authenticate should not be called");
+    }
+  );
+
+  assert.deepEqual(result, { ok: false, error: "Password is required" });
+});

