+from src.api.routes.users import get_user, get_user_items, list_users
 
 
 def test_list_users_returns_active_users():
@@ -13,3 +13,20 @@ def test_get_user_returns_matching_user():
     user = get_user(1)
     assert user is not None
     assert user.name == "Ada"
+
+
+def test_get_user_items_returns_items_for_user():
+    items = get_user_items(1)
+    assert items is not None
+    assert [item["name"] for item in items] == ["Notebook", "Pen"]
+    assert all(item["owner_id"] == 1 for item in items)
+
+
+def test_get_user_items_returns_empty_list_for_user_with_no_items():
+    items = get_user_items(2)
+    assert items is not None
+    assert [item["name"] for item in items] == ["Backpack"]
+
+
+def test_get_user_items_returns_none_for_unknown_user():
+    assert get_user_items(999) is None
