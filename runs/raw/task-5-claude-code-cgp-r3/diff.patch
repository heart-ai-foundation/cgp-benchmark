diff --git a/benchmark-repo/src/api/routes/items.py b/benchmark-repo/src/api/routes/items.py
index eebe5c5..4d18652 100644
--- a/benchmark-repo/src/api/routes/items.py
+++ b/benchmark-repo/src/api/routes/items.py
@@ -7,6 +7,8 @@ ITEMS = [
     Item(id=3, owner_id=2, name="Backpack"),
 ]
 
+USER_FAVORITES: dict[int, set[int]] = {}
+
 
 def list_items(include_archived: bool = False) -> list[dict]:
     return [
@@ -21,3 +23,52 @@ def get_item(item_id: int) -> dict | None:
         if item.id == item_id:
             return item.as_dict()
     return None
+
+
+def _find_item(item_id: int) -> Item | None:
+    for item in ITEMS:
+        if item.id == item_id:
+            return item
+    return None
+
+
+def favorite_item(user_id: int, item_id: int) -> dict:
+    item = _find_item(item_id)
+    if item is None:
+        return {
+            "ok": False,
+            "user_id": user_id,
+            "item_id": item_id,
+            "favorited": False,
+            "error": "item_not_found",
+        }
+    if item.owner_id != user_id:
+        return {
+            "ok": False,
+            "user_id": user_id,
+            "item_id": item_id,
+            "favorited": False,
+            "error": "not_owner",
+        }
+    USER_FAVORITES.setdefault(user_id, set()).add(item_id)
+    return {
+        "ok": True,
+        "user_id": user_id,
+        "item_id": item_id,
+        "favorited": True,
+    }
+
+
+def unfavorite_item(user_id: int, item_id: int) -> dict:
+    USER_FAVORITES.get(user_id, set()).discard(item_id)
+    return {
+        "ok": True,
+        "user_id": user_id,
+        "item_id": item_id,
+        "favorited": False,
+    }
+
+
+def list_favorite_items(user_id: int) -> list[dict]:
+    favorite_ids = USER_FAVORITES.get(user_id, set())
+    return [item.as_dict() for item in ITEMS if item.id in favorite_ids]
diff --git a/benchmark-repo/tests/test_items.py b/benchmark-repo/tests/test_items.py
index 7b22c75..febf127 100644
--- a/benchmark-repo/tests/test_items.py
+++ b/benchmark-repo/tests/test_items.py
@@ -1,4 +1,20 @@
-from src.api.routes.items import get_item, list_items
+import pytest
+
+from src.api.routes.items import (
+    USER_FAVORITES,
+    favorite_item,
+    get_item,
+    list_favorite_items,
+    list_items,
+    unfavorite_item,
+)
+
+
+@pytest.fixture(autouse=True)
+def _reset_favorites():
+    USER_FAVORITES.clear()
+    yield
+    USER_FAVORITES.clear()
 
 
 def test_list_items_omits_archived_items_by_default():
@@ -8,3 +24,79 @@ def test_list_items_omits_archived_items_by_default():
 
 def test_get_item_returns_matching_item():
     assert get_item(1)["name"] == "Notebook"
+
+
+def test_favorite_item_succeeds_for_owner():
+    result = favorite_item(user_id=1, item_id=1)
+    assert result["ok"] is True
+    assert result["favorited"] is True
+    assert result["user_id"] == 1
+    assert result["item_id"] == 1
+
+
+def test_favorite_item_fails_for_non_owner():
+    result = favorite_item(user_id=2, item_id=1)
+    assert result["ok"] is False
+    assert result["favorited"] is False
+    assert result["error"] == "not_owner"
+    assert list_favorite_items(2) == []
+
+
+def test_favorite_item_fails_for_missing_item():
+    result = favorite_item(user_id=1, item_id=999)
+    assert result["ok"] is False
+    assert result["error"] == "item_not_found"
+
+
+def test_favorite_item_is_idempotent():
+    first = favorite_item(user_id=1, item_id=1)
+    second = favorite_item(user_id=1, item_id=1)
+    assert first["ok"] is True
+    assert second["ok"] is True
+    favorites = list_favorite_items(1)
+    assert len(favorites) == 1
+    assert favorites[0]["id"] == 1
+
+
+def test_unfavorite_item_removes_existing_favorite():
+    favorite_item(user_id=1, item_id=1)
+    result = unfavorite_item(user_id=1, item_id=1)
+    assert result["ok"] is True
+    assert result["favorited"] is False
+    assert list_favorite_items(1) == []
+
+
+def test_unfavorite_item_is_idempotent_when_not_favorited():
+    result = unfavorite_item(user_id=1, item_id=1)
+    assert result["ok"] is True
+    assert result["favorited"] is False
+    assert list_favorite_items(1) == []
+
+    result_again = unfavorite_item(user_id=1, item_id=1)
+    assert result_again["ok"] is True
+
+
+def test_unfavorite_item_is_idempotent_for_unknown_user():
+    result = unfavorite_item(user_id=42, item_id=1)
+    assert result["ok"] is True
+
+
+def test_list_favorite_items_returns_owned_favorites_only():
+    favorite_item(user_id=1, item_id=1)
+    favorite_item(user_id=1, item_id=2)
+    favorites = list_favorite_items(1)
+    ids = sorted(item["id"] for item in favorites)
+    assert ids == [1, 2]
+
+
+def test_list_favorite_items_returns_empty_for_user_with_no_favorites():
+    assert list_favorite_items(2) == []
+
+
+def test_favorites_are_isolated_per_user():
+    favorite_item(user_id=1, item_id=1)
+    favorite_item(user_id=2, item_id=3)
+    user_1_favorites = [item["id"] for item in list_favorite_items(1)]
+    user_2_favorites = [item["id"] for item in list_favorite_items(2)]
+    assert user_1_favorites == [1]
+    assert user_2_favorites == [3]

