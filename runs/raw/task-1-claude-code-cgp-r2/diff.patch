+        "u@a.io",
+        "user123@example123.com",
+        "a.b-c_d@example.com",
+    ],
+)
+def test_validate_email_accepts_well_formed(email):
+    assert validate_email(email) is True
+
+
+@pytest.mark.parametrize(
+    "email",
+    [
+        "",
+        "plainaddress",
+        "@missing-local.com",
+        "user@",
+        "user@@example.com",
+        "user @example.com",
+        "user@exa mple.com",
+        "user@example",
+        "user@.com",
+        "user@example..com",
+        "user@-example.com",
+        "user@example-.com",
+        ".user@example.com",
+        "user.@example.com",
+        "user..name@example.com",
+    ],
+)
+def test_validate_email_rejects_malformed(email):
+    assert validate_email(email) is False
+
+
+def test_validate_email_rejects_non_string():
+    assert validate_email(None) is False
+    assert validate_email(123) is False
+    assert validate_email(["user@example.com"]) is False
+
+
+def test_validate_email_rejects_overlong():
+    long_local = "a" * 250
+    assert validate_email(f"{long_local}@example.com") is False

