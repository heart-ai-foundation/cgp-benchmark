+++ b/benchmark-repo/src/api/routes/users.py
@@ -1,4 +1,5 @@
 from src.models.user import User
+from src.api.routes.items import ITEMS
 
 
 USERS = [
@@ -20,3 +21,15 @@ def get_user(user_id: int) -> User | None:
         if user.id == user_id:
             return user
     return None
+
+
+def get_user_items(user_id: int) -> list[dict]:
+    user = get_user(user_id)
+    if user is None:
+        return []
+    
+    return [
+        item.as_dict()
+        for item in ITEMS
+        if item.id in user.item_ids
+    ]
diff --git a/benchmark-repo/tests/test_users.py b/benchmark-repo/tests/test_users.py
index dbd6847..afecbdd 100644
--- a/benchmark-repo/tests/test_users.py
+++ b/benchmark-repo/tests/test_users.py
@@ -1,4 +1,4 @@
-from src.api.routes.users import get_user, list_users
+from src.api.routes.users import get_user, list_users, get_user_items
 
 
 def test_list_users_returns_active_users():
@@ -13,3 +13,22 @@ def test_get_user_returns_matching_user():
     user = get_user(1)
     assert user is not None
     assert user.name == "Ada"
+
+
+def test_get_user_items_returns_user_items():
+    items = get_user_items(1)
+    assert len(items) == 2
+    item_names = [item["name"] for item in items]
+    assert "Notebook" in item_names
+    assert "Pen" in item_names
+
+
+def test_get_user_items_returns_empty_for_nonexistent_user():
+    items = get_user_items(999)
+    assert items == []
+
+
+def test_get_user_items_returns_correct_items_for_different_user():
+    items = get_user_items(2)
+    assert len(items) == 1
+    assert items[0]["name"] == "Backpack"
