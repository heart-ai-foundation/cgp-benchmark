@@ -20,3 +20,13 @@ def get_user(user_id: int) -> User | None:
         if user.id == user_id:
             return user
     return None
+
+
+def list_user_items(user_id: int) -> list[dict] | None:
+    user = get_user(user_id)
+    if user is None:
+        return None
+
+    from src.api.routes.items import ITEMS
+
+    return [item.as_dict() for item in ITEMS if item.owner_id == user_id]
