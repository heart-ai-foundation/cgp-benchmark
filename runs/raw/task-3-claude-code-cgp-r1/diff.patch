diff --git a/benchmark-repo/src/api/routes/users.py b/benchmark-repo/src/api/routes/users.py
index c88d489..9929c25 100644
--- a/benchmark-repo/src/api/routes/users.py
+++ b/benchmark-repo/src/api/routes/users.py
@@ -1,3 +1,4 @@
+from src.api.routes.items import ITEMS
 from src.models.user import User
 
 
@@ -20,3 +21,14 @@ def get_user(user_id: int) -> User | None:
         if user.id == user_id:
             return user
     return None
+
+
+def get_user_items(user_id: int, include_archived: bool = False) -> list[dict] | None:
+    user = get_user(user_id)
+    if user is None:
+        return None
+    return [
+        item.as_dict()
+        for item in ITEMS
+        if item.owner_id == user.id and (include_archived or not item.archived)
+    ]
