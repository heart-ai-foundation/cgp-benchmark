diff --git a/benchmark-repo/src/models/user.py b/benchmark-repo/src/models/user.py
index bdb58ef..36ee3ce 100644
--- a/benchmark-repo/src/models/user.py
+++ b/benchmark-repo/src/models/user.py
@@ -3,6 +3,29 @@ from dataclasses import dataclass, field
 
 @dataclass
 class User:
+    """Represent an application user and their owned item references.
+
+    Attributes:
+        id: Unique integer identifier for the user.
+        email: Email address used for login eligibility checks.
+        name: Display name for the user.
+        active: Whether the user account is enabled. Defaults to True.
+        item_ids: Item identifiers owned by the user. Defaults to an empty list.
+
+    Methods:
+        can_login: Return True when the user is active and the email contains
+            an at-sign.
+        owns_item: Return True when the given item identifier is present in
+            item_ids.
+
+    Example:
+        >>> user = User(id=1, email="ada@example.com", name="Ada", item_ids=[10])
+        >>> user.can_login()
+        True
+        >>> user.owns_item(10)
+        True
+    """
+
     id: int
     email: str
     name: str

