diff --git a/benchmark-repo/src/api/routes/users.py b/benchmark-repo/src/api/routes/users.py
index c88d489..a6bbb4b 100644
--- a/benchmark-repo/src/api/routes/users.py
+++ b/benchmark-repo/src/api/routes/users.py
@@ -20,3 +20,12 @@ def get_user(user_id: int) -> User | None:
         if user.id == user_id:
             return user
     return None
+
+
+def get_user_items(user_id: int) -> list[dict] | None:
+    user = get_user(user_id)
+    if not user:
+        return None
+
+    from src.api.routes.items import ITEMS
+    return [item.as_dict() for item in ITEMS if item.owner_id == user_id]
