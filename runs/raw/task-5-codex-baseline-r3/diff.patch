diff --git a/benchmark-repo/src/api/routes/items.py b/benchmark-repo/src/api/routes/items.py
index eebe5c5..0f3aea2 100644
--- a/benchmark-repo/src/api/routes/items.py
+++ b/benchmark-repo/src/api/routes/items.py
@@ -1,4 +1,5 @@
 from src.models.item import Item
+from src.api.routes.users import get_user
 
 
 ITEMS = [
@@ -21,3 +22,52 @@ def get_item(item_id: int) -> dict | None:
         if item.id == item_id:
             return item.as_dict()
     return None
+
+
+def favorite_item(user_id: int, item_id: int) -> dict:
+    user = get_user(user_id)
+    if user is None or not user.owns_item(item_id):
+        raise ValueError("item is not owned by user")
+
+    item = _get_item_model(item_id)
+    if item is None:
+        raise ValueError("item does not exist")
+
+    if not user.has_favorited_item(item_id):
+        user.favorite_item_ids.append(item_id)
+
+    return item.as_dict()
+
+
+def unfavorite_item(user_id: int, item_id: int) -> dict:
+    user = get_user(user_id)
+    if user is None:
+        raise ValueError("user does not exist")
+
+    item = _get_item_model(item_id)
+    if item is None:
+        raise ValueError("item does not exist")
+
+    if user.has_favorited_item(item_id):
+        user.favorite_item_ids.remove(item_id)
+
+    return item.as_dict()
+
+
+def list_favorite_items(user_id: int) -> list[dict]:
+    user = get_user(user_id)
+    if user is None:
+        raise ValueError("user does not exist")
+
+    return [
+        item.as_dict()
+        for item in ITEMS
+        if item.id in user.favorite_item_ids
+    ]
+
+
+def _get_item_model(item_id: int) -> Item | None:
+    for item in ITEMS:
+        if item.id == item_id:
+            return item
+    return None
