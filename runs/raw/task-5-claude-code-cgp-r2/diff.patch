diff --git a/benchmark-repo/src/api/routes/items.py b/benchmark-repo/src/api/routes/items.py
index eebe5c5..3060835 100644
--- a/benchmark-repo/src/api/routes/items.py
+++ b/benchmark-repo/src/api/routes/items.py
@@ -1,3 +1,4 @@
+from src.api.routes.users import USERS
 from src.models.item import Item
 
 
@@ -21,3 +22,50 @@ def get_item(item_id: int) -> dict | None:
         if item.id == item_id:
             return item.as_dict()
     return None
+
+
+def _find_user(user_id: int):
+    for user in USERS:
+        if user.id == user_id:
+            return user
+    return None
+
+
+def _find_item(item_id: int) -> Item | None:
+    for item in ITEMS:
+        if item.id == item_id:
+            return item
+    return None
+
+
+def favorite_item(user_id: int, item_id: int) -> dict:
+    user = _find_user(user_id)
+    if user is None:
+        return {"ok": False, "error": "user_not_found"}
+    if _find_item(item_id) is None:
+        return {"ok": False, "error": "item_not_found"}
+    if not user.owns_item(item_id):
+        return {"ok": False, "error": "item_not_owned"}
+    if item_id not in user.favorite_item_ids:
+        user.favorite_item_ids.append(item_id)
+    return {"ok": True, "user_id": user_id, "item_id": item_id, "favorited": True}
+
+
+def unfavorite_item(user_id: int, item_id: int) -> dict:
+    user = _find_user(user_id)
+    if user is None:
+        return {"ok": False, "error": "user_not_found"}
+    if item_id in user.favorite_item_ids:
+        user.favorite_item_ids.remove(item_id)
+    return {"ok": True, "user_id": user_id, "item_id": item_id, "favorited": False}
+
+
+def list_favorite_items(user_id: int) -> list[dict]:
+    user = _find_user(user_id)
+    if user is None:
+        return []
+    return [
+        item.as_dict()
+        for item in ITEMS
+        if item.id in user.favorite_item_ids
+    ]
