index bdb58ef..65ed0d1 100644
--- a/benchmark-repo/src/models/user.py
+++ b/benchmark-repo/src/models/user.py
@@ -3,6 +3,32 @@ from dataclasses import dataclass, field
 
 @dataclass
 class User:
+    """A user in the system with authentication and item ownership capabilities.
+    
+    This class represents a user account with basic profile information,
+    authentication status, and item ownership tracking.
+    
+    Attributes:
+        id (int): Unique identifier for the user.
+        email (str): User's email address, used for authentication.
+        name (str): Display name of the user.
+        active (bool): Whether the user account is active. Defaults to True.
+        item_ids (list[int]): List of item IDs owned by this user. Defaults to empty list.
+    
+    Methods:
+        can_login(): Check if user can authenticate based on active status and valid email.
+        owns_item(item_id): Check if user owns a specific item by ID.
+    
+    Example:
+        >>> user = User(id=1, email="john@example.com", name="John Doe")
+        >>> user.can_login()
+        True
+        >>> user.item_ids = [101, 102, 103]
+        >>> user.owns_item(102)
+        True
+        >>> user.owns_item(999)
+        False
+    """
     id: int
     email: str
     name: str
