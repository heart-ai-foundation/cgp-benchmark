+++ b/benchmark-repo/src/models/user.py
@@ -3,6 +3,35 @@ from dataclasses import dataclass, field
 
 @dataclass
 class User:
+    """Represent an application user and the item ids they own.
+
+    Attributes:
+        id: Unique integer identifier for the user.
+        email: Email address used to identify and authenticate the user.
+        name: Display name for the user.
+        active: Whether the user account is enabled. Defaults to ``True``.
+        item_ids: List of item identifiers owned by the user. Defaults to an
+            empty list.
+
+    Methods:
+        can_login: Return ``True`` when the user is active and has an email
+            address containing ``"@"``.
+        owns_item: Return whether the supplied item id is present in
+            ``item_ids``.
+
+    Example:
+        >>> user = User(
+        ...     id=1,
+        ...     email="ada@example.com",
+        ...     name="Ada",
+        ...     item_ids=[10, 11],
+        ... )
+        >>> user.can_login()
+        True
+        >>> user.owns_item(10)
+        True
+    """
+
     id: int
     email: str
     name: str

