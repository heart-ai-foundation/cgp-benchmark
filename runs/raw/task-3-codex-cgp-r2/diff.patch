+from src.api.routes.users import get_user, list_user_items, list_users
 
 
 def test_list_users_returns_active_users():
@@ -13,3 +13,15 @@ def test_get_user_returns_matching_user():
     user = get_user(1)
     assert user is not None
     assert user.name == "Ada"
+
+
+def test_list_user_items_returns_items_for_matching_user():
+    items = list_user_items(1)
+    assert items == [
+        {"id": 1, "owner_id": 1, "name": "Notebook", "archived": False},
+        {"id": 2, "owner_id": 1, "name": "Pen", "archived": False},
+    ]
+
+
+def test_list_user_items_returns_none_for_unknown_user():
+    assert list_user_items(999) is None

