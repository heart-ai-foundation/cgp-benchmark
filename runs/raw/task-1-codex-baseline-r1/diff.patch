diff --git a/benchmark-repo/src/api/validators.py b/benchmark-repo/src/api/validators.py
index 98425ff..5c94f41 100644
--- a/benchmark-repo/src/api/validators.py
+++ b/benchmark-repo/src/api/validators.py
@@ -1,3 +1,9 @@
+import re
+
+
+_EMAIL_PATTERN = re.compile(r"^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$")
+
+
 def require_non_empty(value: str, field_name: str) -> str:
     if not isinstance(value, str) or not value.strip():
         raise ValueError(f"{field_name} is required")
@@ -8,3 +14,19 @@ def validate_positive_int(value: int, field_name: str) -> int:
     if not isinstance(value, int) or value <= 0:
         raise ValueError(f"{field_name} must be a positive integer")
     return value
+
+
+def validate_email(email: str) -> bool:
+    if not isinstance(email, str) or not _EMAIL_PATTERN.fullmatch(email):
+        return False
+
+    local_part, domain = email.rsplit("@", 1)
+    if local_part.startswith(".") or local_part.endswith(".") or ".." in local_part:
+        return False
+
+    return all(
+        label
+        and not label.startswith("-")
+        and not label.endswith("-")
+        for label in domain.split(".")
+    )
