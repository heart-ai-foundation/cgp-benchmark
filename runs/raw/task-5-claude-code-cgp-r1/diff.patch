 from src.models.item import Item
 
 
@@ -21,3 +22,42 @@ def get_item(item_id: int) -> dict | None:
         if item.id == item_id:
             return item.as_dict()
     return None
+
+
+def _find_item(item_id: int) -> Item | None:
+    for item in ITEMS:
+        if item.id == item_id:
+            return item
+    return None
+
+
+def favorite_item(user_id: int, item_id: int) -> dict:
+    user = get_user(user_id)
+    if user is None:
+        raise ValueError(f"unknown user_id={user_id}")
+    if not user.owns_item(item_id):
+        raise ValueError(f"user_id={user_id} does not own item_id={item_id}")
+    if item_id not in user.favorite_item_ids:
+        user.favorite_item_ids.append(item_id)
+    return {"user_id": user_id, "item_id": item_id, "favorited": True}
+
+
+def unfavorite_item(user_id: int, item_id: int) -> dict:
+    user = get_user(user_id)
+    if user is None:
+        raise ValueError(f"unknown user_id={user_id}")
+    if item_id in user.favorite_item_ids:
+        user.favorite_item_ids.remove(item_id)
+    return {"user_id": user_id, "item_id": item_id, "favorited": False}
+
+
+def list_favorite_items(user_id: int) -> list[dict]:
+    user = get_user(user_id)
+    if user is None:
+        raise ValueError(f"unknown user_id={user_id}")
+    favorites = []
+    for item_id in user.favorite_item_ids:
+        item = _find_item(item_id)
+        if item is not None:
+            favorites.append(item.as_dict())
+    return favorites
