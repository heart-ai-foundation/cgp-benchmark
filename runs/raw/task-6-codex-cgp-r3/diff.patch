+test("submitLogin returns an error for empty passwords", async () => {
+  const { submitLogin } = await importJsx("../src/components/LoginForm.jsx");
+  let authenticateCalled = false;
+
+  const result = submitLogin({ email: "ada@example.com", password: "" }, () => {
