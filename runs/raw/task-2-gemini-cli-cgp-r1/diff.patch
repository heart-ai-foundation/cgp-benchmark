 class User:
+    """
+    Represents a user in the system.
+
+    Attributes:
+        id (int): Unique identifier for the user.
+        email (str): User's email address.
+        name (str): User's full name.
+        active (bool): Whether the user account is active. Defaults to True.
+        item_ids (list[int]): List of IDs of items owned by the user.
+
+    Methods:
+        can_login() -> bool:
+            Determines if the user is eligible to log in.
+        owns_item(item_id: int) -> bool:
+            Checks if the user owns the specified item ID.
+
+    Example:
+        >>> user = User(id=1, email="user@example.com", name="John Doe")
+        >>> user.can_login()
+        True
+        >>> user.owns_item(42)
+        False
+    """
     id: int
     email: str
     name: str

